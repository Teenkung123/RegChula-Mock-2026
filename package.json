{
  "name": "regchula-clean-room",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "elysia": "2.0.0-beta.11"
  },
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/api build && bun run --cwd apps/web build",
    "typecheck": "bun run --cwd apps/api typecheck && bun run --cwd apps/web typecheck",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "bun test --preload ./apps/api/src/test/setup.ts apps/api/src && bun run --cwd apps/web test",
    "test:web": "bun run --cwd apps/web test",
    "test:e2e": "bun x playwright test",
    "test:planning": "node --env-file=.env.local node_modules/@playwright/test/cli.js test --config tests/planning.config.ts",
    "test:visual": "node scripts/visual-qa.mjs",
    "check:elysia": "bun run scripts/check-elysia-conventions.ts",
    "check:clean-room": "bun run scripts/check-clean-room.ts",
    "check:deployment-security": "bun run scripts/check-deployment-security.ts",
    "check": "bun run check:elysia && bun run check:clean-room && bun run check:deployment-security && bun run catalog:validate && bun run lint && bun run typecheck && bun run test && bun run test:auth:safety && bun run test:registration:concurrency && bun run test:load:verify && bun run build",
    "db:generate": "bun run --cwd apps/api db:generate",
    "db:migrate": "bun run apps/api/src/cli/migrate.ts",
    "catalog:import": "bun run apps/api/src/cli/catalog-import.ts",
    "catalog:fetch": "bun run scripts/fetch-cugetreg-catalogs.ts",
    "catalog:validate": "bun run apps/api/src/cli/catalog-validate.ts",
    "catalog:status": "bun run apps/api/src/cli/catalog-status.ts",
    "buildings:import": "bun run scripts/import-buildings.ts",
    "faculties:import": "bun run scripts/import-faculties.ts",
    "term:list": "bun run apps/api/src/cli/term-list.ts",
    "term:set": "bun run apps/api/src/cli/term-set.ts",
    "setup:env": "bun run scripts/setup-env.ts",
    "setup:k8s-env": "bun run scripts/setup-k8s-env.ts",
    "test:load:prepare": "bun run apps/api/src/cli/load-prepare.ts",
    "test:load:verify": "bun run apps/api/src/cli/integrity-check.ts",
    "test:registration:concurrency": "bun run apps/api/src/cli/registration-concurrency-check.ts",
    "test:auth:safety": "bun run apps/api/src/cli/auth-safety-check.ts",
    "auth:cleanup": "bun run apps/api/src/cli/auth-state-cleanup.ts",
    "benchmark:prepare": "bun run apps/api/src/cli/benchmark-fixture.ts prepare",
    "benchmark:cleanup": "bun run apps/api/src/cli/benchmark-fixture.ts cleanup"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/bun": "1.4.0",
    "typescript": "6.0.3"
  }
}
