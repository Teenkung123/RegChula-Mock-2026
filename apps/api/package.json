{
  "name": "@regchula/api",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts",
    "./public-types": "./src/public-types.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --minify",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test --preload ./src/test/setup.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@elysia/openapi": "2.0.0-beta.2",
    "drizzle-orm": "0.45.2",
    "elysia": "2.0.0-beta.11",
    "exact-mirror": "1.2.4",
    "mysql2": "3.24.2",
    "openapi-types": "12.1.3",
    "pdfkit": "0.20.2",
    "typebox": "1.3.24"
  },
  "devDependencies": {
    "@types/pdfkit": "0.17.6",
    "drizzle-kit": "0.31.10",
    "typescript": "6.0.3"
  }
}
