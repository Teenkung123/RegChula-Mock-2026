APP_ENV=development
AUTH_MODE=local-mock
API_HOST=127.0.0.1
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
# Comma-separated exact LAN/Tailscale website URLs, including :5173 (no trailing slash).
WEB_ADDITIONAL_ORIGINS=
DATABASE_URL=mysql://regchula:regchula_dev@127.0.0.1:3307/regchula
REDIS_URL=redis://:regchula_redis_dev@127.0.0.1:6380
DB_POOL_SIZE=20
DB_POOL_QUEUE_LIMIT=300
DB_CONNECT_TIMEOUT_MS=5000
API_MAX_IN_FLIGHT_REQUESTS=300
API_MAX_REQUEST_BODY_BYTES=65536
API_SHUTDOWN_GRACE_MS=15000
AUTH_CHALLENGE_RATE_PER_SECOND=300
AUTH_CHALLENGE_BURST=600
AUTH_LOGIN_RATE_PER_SECOND=250
AUTH_LOGIN_BURST=500
AUTH_GLOBAL_CHALLENGE_RATE_PER_SECOND=600
AUTH_GLOBAL_LOGIN_RATE_PER_SECOND=400
MOCK_AUTH_MAX_STUDENTS=49920
COOKIE_SECRET=replace-with-at-least-32-random-characters
CHALLENGE_SECRET=replace-with-at-least-32-random-characters
CONFIRMATION_SECRET=replace-with-at-least-32-random-characters
